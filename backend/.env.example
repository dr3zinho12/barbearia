# URL de conexão do PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/black_blue_barber?schema=public"

# Porta da API
PORT=3333

# Ambiente
NODE_ENV=development

# Segredo usado para assinar os tokens JWT (troque por um valor aleatório forte em produção)
JWT_SECRET="troque-este-valor-por-um-segredo-forte-e-aleatorio"

# Tempo de expiração do token JWT
JWT_EXPIRES_IN="7d"

# Origem permitida para requisições do Front-End (CORS)
CORS_ORIGIN="http://localhost:5173"
